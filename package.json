{
	"name": "@uulab/picos",
	"version": "0.2.0",
	"description": "A tiny terminal OS for developers.",
	"type": "module",
	"bin": {
		"picos": "./dist/bin/picos.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"docs/LOCAL_AUTOMATION.md",
		"docs/REMOTE_AUTOMATION.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun src/bin/picos.ts",
		"build": "bun build src/bin/picos.ts --outdir dist/bin --target node --external ink --external react --external ssh2",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format . --write",
		"smoke": "bun scripts/harness.ts smoke",
		"integration:local-json": "bun scripts/localInspectorIntegration.ts",
		"integration:diagnostics-json": "bun scripts/diagnosticsJsonIntegration.ts",
		"integration:operations-json": "bun scripts/operationsJsonIntegration.ts",
		"integration:sftp": "bun scripts/sftpIntegration.ts",
		"verify": "bun scripts/harness.ts verify",
		"release:check": "bun run build && bun scripts/releaseCheck.ts && npm pack --dry-run",
		"release:notes": "bun scripts/releaseNotes.ts",
		"release:changelog": "bun scripts/finalizeChangelog.ts",
		"release:commands": "bun scripts/releaseCommands.ts",
		"version:plan": "bun scripts/version.ts plan",
		"version:next": "bun scripts/version.ts next",
		"version:set": "bun scripts/version.ts set",
		"harness": "bun scripts/harness.ts"
	},
	"keywords": [
		"cli",
		"tui",
		"terminal",
		"network",
		"developer-tools",
		"bun"
	],
	"license": "MIT",
	"dependencies": {
		"cac": "^7.0.0",
		"ink": "^7.1.0",
		"react": "^19.2.7",
		"ssh2": "^1.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/node": "26.0.1",
		"@types/react": "^19.2.17",
		"@types/ssh2": "^1.15.5",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
